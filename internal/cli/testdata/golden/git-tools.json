{
  "$schema": "https://nono.sh/schemas/nono-profile.schema.json",
  "extends": [
    "jr/clean_env"
  ],
  "groups": {
    "include": [
      {
        "name": "linux_temp_read",
        "when": "linux"
      },
      "unlink_protection",
      "mise_manager",
      "node_runtime",
      "git_config"
    ]
  },
  "filesystem": {
    "allow": [
      "$WORKDIR/.nono/nn",
      "$HOME/.local/state/mise",
      "$HOME/.cache/mise"
    ]
  },
  "network": {
    "allow_domain": [
      "gitlab.com"
    ]
  },
  "environment": {
    "allow_vars": [
      "PATH",
      "HOME",
      "USER",
      "SHELL",
      "TERM",
      "LANG",
      "LC_*",
      "TMPDIR",
      "NODE_*",
      "NPM_*"
    ],
    "set_vars": {
      "GIT_AUTHOR_EMAIL": "test@example.com",
      "GIT_AUTHOR_NAME": "Test User",
      "GIT_COMMITTER_EMAIL": "test@example.com",
      "GIT_COMMITTER_NAME": "Test User"
    }
  },
  "workdir": {
    "access": "readwrite"
  }
}
