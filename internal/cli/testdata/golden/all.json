{
  "$schema": "https://nono.sh/schemas/nono-profile.schema.json",
  "extends": [
    "nolabs-ai/claude"
  ],
  "groups": {
    "include": [
      {
        "name": "linux_temp_read",
        "when": "linux"
      },
      "mise_manager",
      "git_config"
    ]
  },
  "filesystem": {
    "allow": [
      "$WORKDIR/.nono/nn",
      "$HOME/.local/state/mise",
      "$HOME/.cache/mise",
      {
        "path": "$HOME/Library/Caches/mise",
        "when": "macos"
      }
    ]
  },
  "network": {
    "allow_domain": [
      "api.github.com",
      "github.com",
      "dev.azure.com",
      "ABCDEF.gr7.eu-west-1.eks.amazonaws.com"
    ],
    "credentials": [
      "github",
      "github_git",
      "azure_devops",
      "k8s"
    ],
    "custom_credentials": {
      "azure_devops": {
        "upstream": "https://dev.azure.com",
        "credential_key": "env://NN_AZURE_DEVOPS_PAT",
        "env_var": "AZURE_DEVOPS_EXT_PAT",
        "inject_mode": "basic_auth"
      },
      "github": {
        "upstream": "https://api.github.com",
        "credential_key": "env://NN_GITHUB_TOKEN",
        "env_var": "GITHUB_TOKEN",
        "inject_mode": "header",
        "inject_header": "Authorization",
        "credential_format": "token {}"
      },
      "github_git": {
        "upstream": "https://github.com",
        "credential_key": "env://NN_GITHUB_GIT_AUTH",
        "env_var": "GITHUB_GIT_AUTH",
        "inject_mode": "basic_auth"
      },
      "k8s": {
        "upstream": "https://ABCDEF.gr7.eu-west-1.eks.amazonaws.com",
        "credential_key": "cmd://k8s",
        "env_var": "K8S_TOKEN",
        "inject_mode": "header",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}",
        "tls_ca": "$WORKDIR/.nono/nn/kube/ca.pem"
      }
    }
  },
  "environment": {
    "allow_vars": [
      "PATH",
      "HOME",
      "USER",
      "SHELL",
      "TERM",
      "LANG",
      "LC_*",
      "TMPDIR"
    ],
    "set_vars": {
      "AZURE_CONFIG_DIR": "$WORKDIR/.nono/nn/az",
      "AZURE_DEVOPS_CACHE_DIR": "$WORKDIR/.nono/nn/az/devops-cache",
      "GH_CONFIG_DIR": "$WORKDIR/.nono/nn/gh",
      "GIT_AUTHOR_EMAIL": "test@example.com",
      "GIT_AUTHOR_NAME": "Test User",
      "GIT_COMMITTER_EMAIL": "test@example.com",
      "GIT_COMMITTER_NAME": "Test User",
      "GIT_CONFIG_COUNT": "4",
      "GIT_CONFIG_KEY_0": "url.https://github.com/.insteadOf",
      "GIT_CONFIG_KEY_1": "url.https://github.com/.insteadOf",
      "GIT_CONFIG_KEY_2": "url.https://dev.azure.com/acme/Platform/_git/.insteadOf",
      "GIT_CONFIG_KEY_3": "url.https://dev.azure.com/acme/Platform/_git/.insteadOf",
      "GIT_CONFIG_VALUE_0": "git@github.com:",
      "GIT_CONFIG_VALUE_1": "ssh://git@github.com/",
      "GIT_CONFIG_VALUE_2": "git@ssh.dev.azure.com:v3/acme/Platform/",
      "GIT_CONFIG_VALUE_3": "ssh://git@ssh.dev.azure.com/v3/acme/Platform/",
      "KUBECACHEDIR": "$WORKDIR/.nono/nn/kube/cache",
      "KUBECONFIG": "$WORKDIR/.nono/nn/kube/config"
    }
  },
  "workdir": {
    "access": "readwrite"
  },
  "credential_capture": {
    "k8s": {
      "command": [
        "/usr/local/bin/kubectl",
        "--kubeconfig",
        "/TESTDIR/kubeconfig.yaml",
        "--context",
        "prod-eks",
        "create",
        "token",
        "claude-ro",
        "-n",
        "apps",
        "--duration=1h"
      ],
      "timeout_secs": 30,
      "cache_ttl_secs": 2880
    }
  }
}
