{
  "$schema": "https://nono.sh/schemas/nono-profile.schema.json",
  "groups": {
    "include": [
      {
        "name": "linux_temp_read",
        "when": "linux"
      }
    ]
  },
  "filesystem": {
    "allow": [
      "$WORKDIR/.nono/nn"
    ]
  },
  "network": {
    "allow_domain": [
      "34.1.2.3"
    ],
    "credentials": [
      "k8s"
    ],
    "custom_credentials": {
      "k8s": {
        "upstream": "https://34.1.2.3",
        "credential_key": "cmd://k8s",
        "env_var": "K8S_TOKEN",
        "inject_mode": "header",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}",
        "tls_ca": "$WORKDIR/.nono/nn/kube/ca.pem"
      }
    }
  },
  "environment": {
    "allow_vars": [
      "PATH",
      "HOME",
      "USER",
      "SHELL",
      "TERM",
      "LANG",
      "LC_*",
      "TMPDIR"
    ],
    "set_vars": {
      "GIT_CONFIG_COUNT": "1",
      "GIT_CONFIG_KEY_0": "credential.helper",
      "GIT_CONFIG_VALUE_0": "",
      "KUBECACHEDIR": "$WORKDIR/.nono/nn/kube/cache",
      "KUBECONFIG": "$WORKDIR/.nono/nn/kube/config"
    }
  },
  "workdir": {
    "access": "readwrite"
  },
  "linux": {
    "af_unix_mediation": "pathname"
  },
  "credential_capture": {
    "k8s": {
      "command": [
        "/usr/local/bin/nn",
        "credential",
        "kubernetes",
        "--kubeconfig",
        "/TESTDIR/kubeconfig.yaml",
        "--context",
        "gke_project_europe-west4_dev"
      ],
      "timeout_secs": 30,
      "cache_ttl_secs": 60
    }
  }
}
