{
  "$schema": "https://nono.sh/schemas/nono-profile.schema.json",
  "extends": [
    "default",
    "nolabs-ai/antigravity"
  ],
  "groups": {
    "include": [
      {
        "name": "linux_temp_read",
        "when": "linux"
      },
      "git_config"
    ]
  },
  "filesystem": {
    "allow": [
      "$WORKDIR/.nono/nn"
    ],
    "read_file": [
      {
        "path": "/etc/gitconfig",
        "when": "linux"
      }
    ]
  },
  "network": {
    "network_profile": "minimal",
    "allow_domain": [
      "proxy.golang.org",
      "cloudcode-pa.googleapis.com",
      "oauth2.googleapis.com"
    ],
    "open_port_range": [
      [
        49152,
        65535
      ]
    ]
  },
  "environment": {
    "allow_vars": [
      "PATH",
      "HOME",
      "USER",
      "SHELL",
      "TERM",
      "LANG",
      "LC_*",
      "TMPDIR"
    ],
    "set_vars": {
      "GIT_AUTHOR_EMAIL": "test@example.com",
      "GIT_AUTHOR_NAME": "Test User",
      "GIT_COMMITTER_EMAIL": "test@example.com",
      "GIT_COMMITTER_NAME": "Test User"
    }
  },
  "workdir": {
    "access": "readwrite"
  },
  "linux": {
    "af_unix_mediation": "pathname"
  }
}
