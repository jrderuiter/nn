{
  "$schema": "https://nono.sh/schemas/nono-profile.schema.json",
  "extends": [
    "nolabs-ai/claude"
  ],
  "filesystem": {
    "allow": [
      "$WORKDIR/.nono/nn"
    ]
  },
  "network": {
    "allow_domain": [
      "dev.azure.com"
    ],
    "credentials": [
      "azure_devops"
    ],
    "custom_credentials": {
      "azure_devops": {
        "upstream": "https://dev.azure.com",
        "credential_key": "env://NN_AZURE_DEVOPS_PAT",
        "env_var": "AZURE_DEVOPS_EXT_PAT",
        "inject_mode": "basic_auth"
      }
    }
  },
  "environment": {
    "allow_vars": [
      "PATH",
      "HOME",
      "USER",
      "SHELL",
      "TERM",
      "LANG",
      "LC_*",
      "TMPDIR"
    ],
    "set_vars": {
      "AZURE_CONFIG_DIR": "$WORKDIR/.nono/nn/az",
      "GIT_CONFIG_COUNT": "5",
      "GIT_CONFIG_KEY_0": "url.https://dev.azure.com/acme/Data%20Science/_git/.insteadOf",
      "GIT_CONFIG_KEY_1": "url.https://dev.azure.com/acme/Data%20Science/_git/.insteadOf",
      "GIT_CONFIG_KEY_2": "url.https://dev.azure.com/acme/Platform/_git/.insteadOf",
      "GIT_CONFIG_KEY_3": "url.https://dev.azure.com/acme/Platform/_git/.insteadOf",
      "GIT_CONFIG_KEY_4": "url.https://dev.azure.com/acme/Platform/_git/.insteadOf",
      "GIT_CONFIG_VALUE_0": "git@ssh.dev.azure.com:v3/acme/Data%20Science/",
      "GIT_CONFIG_VALUE_1": "ssh://git@ssh.dev.azure.com/v3/acme/Data%20Science/",
      "GIT_CONFIG_VALUE_2": "git@ssh.dev.azure.com:v3/acme/Platform/",
      "GIT_CONFIG_VALUE_3": "git@team.ssh.dev.azure.com:v3/acme/Platform/",
      "GIT_CONFIG_VALUE_4": "ssh://git@ssh.dev.azure.com/v3/acme/Platform/"
    }
  },
  "workdir": {
    "access": "readwrite"
  }
}
