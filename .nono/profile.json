{
  "$schema": "./nono-profile.schema.json",
  "meta": { "name": "claude-nn", "version": "1.0.0" },
  "extends": "nolabs-ai/claude",
  "groups": {
    "include": ["go_runtime", "go_runtime_linux", "go_runtime_macos"]
  },
  "network": {
    "network_profile": "claude-code",
    "credentials": ["github"],
    "allow_domain": ["proxy.golang.org", "sum.golang.org"]
  },
  "filesystem": {
    "read": ["$HOME/.local/share/mise", "$HOME/.config/mise"],
    "allow": ["$HOME/.local/state/mise", "$HOME/.cache/mise"]
  },
  "environment": {
    "set_vars": { "GH_CONFIG_DIR": "$WORKDIR/.nono/gh" },
    "allow_vars": ["PATH", "HOME", "USER", "SHELL", "TERM", "LANG", "LC_*", "TMPDIR"]
  }
}
